# Copy to .env for local development. Do not commit .env.
# Docker Compose creates random secrets in the data volume when these are empty.

# Where household data is stored. Docker uses /data.
DATA_DIR=./data

# Web port.
PORT=3847

# Signs the parent session cookie. At least 32 characters, no spaces.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Shared secret for the Ask the Hub bridge. The bridge refuses to listen without this.
# It is not a default password. Generate a new value for every install.
BRIDGE_TOKEN=

# Keep the assistant bridge on localhost. It is not a LAN service.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787

# Set to 1 only if you intentionally publish the bridge beyond localhost.
# You still need BRIDGE_TOKEN. Prefer leaving this unset.
# BRIDGE_ALLOW_LAN=0

# Optional. Claude is used when this is set. Otherwise the bridge tries Ollama.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional local model. Example: http://127.0.0.1:11434
OLLAMA_URL=
OLLAMA_MODEL=llama3.2

# Optional. Household-wide caps on Ask the Hub questions sent to the model.
# Defaults: 6 per minute and 100 per day.
ASK_MAX_PER_MINUTE=6
ASK_MAX_PER_DAY=100

# Optional folder of jpg, jpeg, png, or webp pictures for the screensaver.
# File names may use only letters, numbers, dots, dashes and underscores.
# Docker mounts ./photos here.
PHOTO_DIR=./photos

# Optional. Open Library is used when this is empty.
GOOGLE_BOOKS_API_KEY=

# 1 = each screen asks for the parent PIN once, then stays unlocked for 30 days.
# Docker Compose turns this on. Set 0 only for a single screen that nobody else
# on the network can reach.
REQUIRE_AUTH_FOR_READS=0

# Set when the site is served over HTTPS so the unlock cookies are marked Secure.
# Over plain http on the home network, the PIN and cookies are not encrypted in transit.
# PUBLIC_URL=https://hub.example
