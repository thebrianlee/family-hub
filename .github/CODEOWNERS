# Code owners for Family Hub. See docs/maintainers/repo-setup.md, section 5.
#
# @hjunk reviews and approves pull requests. With "Require review from Code
# Owners" on, a pull request needs an approval from an owner of every file it
# changes. GitHub never lets authors approve their own pull requests.
# Later rules win over earlier ones.

# Default owner for everything.
*                       @hjunk

# Sensitive paths: access control, PIN, outbound fetches, the assistant
# bridge, the container, scripts and repository automation. Keep these owned
# by core maintainers only, even after skill owners or other maintainers are
# added to the default rule above.
/src/app/api/**         @hjunk
/src/proxy.ts           @hjunk
/src/lib/session.ts     @hjunk
/src/lib/guard.ts       @hjunk
/src/lib/auth.ts        @hjunk
/src/lib/pin-attempts.ts @hjunk
/src/lib/safe-fetch.ts  @hjunk
/bridge/**              @hjunk
/Dockerfile             @hjunk
/docker-compose*.yml    @hjunk
/docker/**              @hjunk
/scripts/**             @hjunk
/.github/**             @hjunk
