#!/usr/bin/env python3
"""Sproutwall install helper: `doctor` and `verify-image`.

Python 3.11+ standard library only. No telemetry; nothing is sent anywhere.
See docs/install-cli.md.
"""

import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from sproutwall_lib.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
